# Gmail SMTP — Gmail account that SENDS the site emails
SMTP_USER=pathpixhub@gmail.com
# Gmail "App Password" (16 chars, no spaces) — NOT your normal password
SMTP_PASS=your-16-char-app-password

# Where submissions are delivered (usually the same as SMTP_USER)
TO_EMAIL=pathpixhub@gmail.com

# --- Supabase (Level 2 client account system) ---
# Create a free project at https://supabase.com -> Settings > API
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key

# After adding the keys, apply the SQL in:
#   supabase/migrations/0001_initial.sql
#   (Supabase Dashboard -> SQL Editor -> paste -> Run)
